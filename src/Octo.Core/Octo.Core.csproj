<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>Octo.Core</PackageId>    
    <Authors>Octo Architecture Team</Authors>
    <Description>Biblioteca core de Domain-Driven Design, abstrações e Result Pattern para o ecossistema Octo.</Description>
    <RepositoryUrl>https://github.com/octo-hq/Octo.BuildingBlocks</RepositoryUrl>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Flunt" Version="2.0.5" />
  </ItemGroup>

</Project>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>Octo.Infrastructure.Tenant</PackageId>
    <Version>1.0.0</Version>
    <Authors>Octo Architecture Team</Authors>
    <Description>Biblioteca de infraestrutura para suporte a Multi-Tenancy e Global Query Filters do EF Core no ecossistema Octo.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Octo.Core\Octo.Core.csproj" />
  </ItemGroup>
  
</Project>